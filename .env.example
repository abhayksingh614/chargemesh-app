# ─────────────────────────────────────────────────────────────────────────────
# ChargeMesh — Root Environment Variables Template
# Copy this file to .env and fill in values for local development.
# NEVER commit .env files. Use AWS Secrets Manager for production.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_NAME=chargemesh
APP_VERSION=1.0.0

# ─── Database (PostgreSQL + PostGIS) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chargemesh_dev
DB_USER=chargemesh
DB_PASSWORD=your_db_password_here
DB_SSL=false

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET_NAME=chargemesh-dev-assets
AWS_SES_FROM_EMAIL=noreply@chargemesh.com

# ─── SMS / OTP ───────────────────────────────────────────────────────────────
# Configure your OTP/SMS provider credentials here
SMS_PROVIDER=aws_sns
SMS_SENDER_ID=CHMESH
# Or use a dedicated OTP provider:
# OTP_PROVIDER_API_KEY=your_otp_provider_key

# ─── MapLibre ────────────────────────────────────────────────────────────────
# MapLibre is open-source; configure your tile server/style URL if using a hosted tile provider
MAPLIBRE_TILE_SERVER_URL=https://your-tile-server.example.com
MAPLIBRE_API_KEY=your_maptile_api_key_if_needed

# ─── Backend API ─────────────────────────────────────────────────────────────
BACKEND_PORT=3001
BACKEND_API_URL=http://localhost:3001
BACKEND_API_PREFIX=/api/v1

# ─── Admin Portal ────────────────────────────────────────────────────────────
ADMIN_PORT=3000
ADMIN_URL=http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Options: debug | info | warn | error

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Session / Charging ──────────────────────────────────────────────────────
# Max time (ms) to wait for CPO start command response before timeout
CPO_START_COMMAND_TIMEOUT_MS=30000
# Max time (ms) to wait for CPO stop command response
CPO_STOP_COMMAND_TIMEOUT_MS=15000
# Stale status threshold (seconds) — after this, status becomes STALE
CPO_STATUS_STALE_THRESHOLD_SECONDS=300

# ─── OCPI ────────────────────────────────────────────────────────────────────
OCPI_PARTY_ID=CM
OCPI_COUNTRY_CODE=IN
OCPI_PARTY_NAME=ChargeMesh
OCPI_PLATFORM_URL=http://localhost:3001
