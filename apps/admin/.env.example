# ─────────────────────────────────────────────────────────────────────────────
# ChargeMesh Admin Portal — Environment Variables Template (Next.js)
# Copy this file to apps/admin/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# All NEXT_PUBLIC_ variables are exposed to the browser.
# All other variables are server-side only.

NODE_ENV=development

# ─── Backend API ─────────────────────────────────────────────────────────────
# Server-side (internal — not exposed to browser)
BACKEND_API_URL=http://localhost:3001/api/v1
BACKEND_API_SECRET=your_internal_api_secret_here

# ─── NextAuth / Admin Auth ───────────────────────────────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# ─── Public Variables (exposed to browser) ───────────────────────────────────
NEXT_PUBLIC_APP_NAME=ChargeMesh Admin
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# ─── MapLibre ────────────────────────────────────────────────────────────────
# Used in admin station map views
NEXT_PUBLIC_MAPLIBRE_TILE_URL=https://your-tile-server.example.com/style.json
NEXT_PUBLIC_MAPLIBRE_API_KEY=your_maptile_api_key_if_needed

# ─── Sentry (optional — error monitoring) ────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/yyyy
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ─── Analytics (optional) ────────────────────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_MAX_AGE_SECONDS=28800
