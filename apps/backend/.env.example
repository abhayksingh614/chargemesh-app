# ─────────────────────────────────────────────────────────────────────────────
# ChargeMesh Backend — Environment Variables Template (NestJS)
# Copy this file to apps/backend/.env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chargemesh:your_db_password_here@localhost:5432/chargemesh_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chargemesh_dev
DB_USER=chargemesh
DB_PASSWORD=your_db_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT_SECONDS=300

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_64_chars_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP / Auth ──────────────────────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CURRENCY=INR

# ─── Firebase Admin (Push Notifications) ─────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=chargemesh-dev-assets
AWS_S3_REGION=ap-south-1
AWS_SES_FROM_EMAIL=noreply@chargemesh.com
AWS_SES_REGION=ap-south-1

# ─── SMS / OTP Delivery ──────────────────────────────────────────────────────
SMS_SENDER_ID=CHMESH
# AWS SNS is default — add provider-specific keys below if using dedicated OTP provider

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# ─── OCPI (CPO Integration) ──────────────────────────────────────────────────
OCPI_PARTY_ID=CM
OCPI_COUNTRY_CODE=IN
OCPI_PARTY_NAME=ChargeMesh
OCPI_PLATFORM_URL=http://localhost:3001
OCPI_PLATFORM_VERSION=2.3.0

# ─── Charging Session Rules ──────────────────────────────────────────────────
CPO_START_COMMAND_TIMEOUT_MS=30000
CPO_STOP_COMMAND_TIMEOUT_MS=15000
CPO_STATUS_STALE_THRESHOLD_SECONDS=300
CPO_STATUS_UNKNOWN_THRESHOLD_SECONDS=900
SESSION_MAX_IDLE_SECONDS=7200

# ─── Pagination Defaults ─────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ─── Health Check ────────────────────────────────────────────────────────────
HEALTH_CHECK_PATH=/api/v1/health
