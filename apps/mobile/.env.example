# ─────────────────────────────────────────────────────────────────────────────
# ChargeMesh Mobile — Environment Variables Template (React Native)
# Uses react-native-dotenv or react-native-config
# Copy this file to apps/mobile/.env
# NEVER commit apps/mobile/.env — it is excluded via .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─── App Config ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production
APP_NAME=ChargeMesh
APP_VERSION=1.2.5
NODE_ENV=development

# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the ChargeMesh backend API.
# IMPORTANT: This must NEVER be a CPO's direct API URL.
# All CPO communication goes through the backend.
# NOTE: Mobile currently uses LOCAL MOCK DATA — this URL is for future backend integration.
API_BASE_URL=http://10.0.2.2:3001/api/v1
# 10.0.2.2 = Android emulator localhost equivalent
# Use your local IP for physical device testing, e.g. http://192.168.1.x:3001/api/v1

# ─── MapLibre ────────────────────────────────────────────────────────────────
MAPLIBRE_TILE_URL=https://your-tile-server.example.com/style.json
MAPLIBRE_API_KEY=your_maptile_api_key_if_needed

# ─── Firebase ────────────────────────────────────────────────────────────────
# These are public identifiers (safe to include in the mobile app bundle)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=1:000000000000:android:xxxxxxxxxxxxxxxxxx
FIREBASE_MESSAGING_SENDER_ID=000000000000
# For iOS:
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxxxxxxxx

# ─── Google Sign-In ──────────────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → google-services.json
GOOGLE_SIGNIN_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_SIGNIN_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Only the PUBLIC key ID goes into the mobile app
# NEVER put the Razorpay secret key in the mobile app — keep it server-side only
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Feature Flags ───────────────────────────────────────────────────────────
FEATURE_MOCK_DATA=true            # true = use local mock data; false = use real API
FEATURE_ECO_IMPACT=true
FEATURE_WALLET=true
FEATURE_RESERVATIONS=false
FEATURE_SMART_CHARGING=false
FEATURE_GOOGLE_SIGNIN=false       # true = enable real Google Sign-In
FEATURE_PUSH_NOTIFICATIONS=false  # true = enable real FCM push notifications
FEATURE_PAYMENTS=false            # true = enable real Razorpay payments

# ─── Logging ─────────────────────────────────────────────────────────────────
ENABLE_FLIPPER=true
LOG_LEVEL=debug
# Options: debug | info | warn | error

# ─── DEV / TEST ONLY ─────────────────────────────────────────────────────────
# !! WARNING: For development and testing ONLY.
# !! MUST be removed or set to false/empty before any production release.
# !! Do NOT commit real credentials to this file or any .env file.
DEV_DEMO_OTP=123456
DEV_SKIP_OTP_VERIFICATION=true

